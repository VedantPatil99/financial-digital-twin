digraph G {
rankdir=TB; nodesep=0.12; ranksep=0.28; dpi=400;
node [fontname="Liberation Serif", fontsize=14, shape=box, style="rounded", height=0.3, margin="0.06,0.03"];
edge [fontname="Liberation Serif", fontsize=12.5, arrowsize=0.6];
gdp_yoy [label="GDP growth", style="rounded,filled", fillcolor="#E8E8E8"];
inflation_yoy [label="CPI inflation", style="rounded,filled", fillcolor="#E8E8E8"];
demand_shock [label="demand shock*", style="rounded,filled", fillcolor="#E8E8E8"];
supply_cost_shock [label="supply-cost shock*", style="rounded,filled", fillcolor="#E8E8E8"];
fx_shock [label="FX shock*", style="rounded,filled", fillcolor="#E8E8E8"];
{rank=same; gdp_yoy; inflation_yoy; demand_shock; fx_shock; supply_cost_shock;}
gross_profit [label="Gross profit", peripheries=2];
operating_income [label="Operating income", peripheries=2];
revenue [label="Revenue"];
cogs [label="COGS"];
opex [label="Opex"];
inventory [label="Inventory"];
receivables [label="Receivables"];
payables [label="Payables"];
