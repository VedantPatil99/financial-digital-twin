inflation_yoy -> revenue [label=" -1.42 (L3)"];
revenue -> cogs [label=" 0.92"];
inflation_yoy -> cogs [label=" -0.65 (L3)"];
revenue -> opex [label=" 0.20 (L3)"];
inflation_yoy -> opex [label=" 0.24 (L2)"];
cogs -> inventory [label=" 0.74"];
