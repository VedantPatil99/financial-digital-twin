demand_shock -> revenue [style=dashed, label=" 1.00"];
fx_shock -> revenue [style=dashed, label=" 0.60"];
supply_cost_shock -> cogs [style=dashed, label=" 1.00"];
revenue -> gross_profit [style=dotted, arrowhead=empty];
cogs -> gross_profit [style=dotted, arrowhead=empty];
gross_profit -> operating_income [style=dotted, arrowhead=empty];
opex -> operating_income [style=dotted, arrowhead=empty];
}